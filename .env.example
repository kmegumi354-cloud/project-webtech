# คัดลอกเป็น .env.local แล้วใส่ค่าจริง
# สร้าง AUTH_SECRET ด้วย: openssl rand -base64 32
AUTH_SECRET=
# Google Cloud Console > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# (ไม่บังคับ) Upstash Redis สำหรับเก็บรายการติดตาม — จำเป็นเมื่อ deploy บน Vercel
# ถ้าไม่ใส่ จะเก็บในไฟล์ .data/watchlist.json แทน
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
